%% --- Entornos numerados: definicion, proposicion, teorema, ejemplo, ejercicio, demostracion ---
%% Uso: \begin{ejemplo}[Título opcional] ... \end{ejemplo}; \begin{demostracion} ... \end{demostracion};
%% \solucion{texto breve} tras un ejercicio. definicion/ejemplo/proposicion/teorema comparten
%% contador por capítulo (Definición 6.1, Ejemplo 6.2, ...); ejercicio tiene contador propio.
\theoremstyle{definition}
\newtheorem{definicion}{Definición}[chapter]
\newtheorem{ejemplo}[definicion]{Ejemplo}
\theoremstyle{plain}
